# Provider selection: auto | codex | mimo | minimax | openai | local
CREATIVE_PROVIDER=auto
CREATIVE_MODEL_TIMEOUT_MS=90000
# One server-owned generation job has a three-minute global deadline.
GENERATION_JOB_TOTAL_TIMEOUT_MS=180000

# Codex CLI uses the existing local login; no API key is stored here.
CODEX_BINARY=
# Terra owns the bounded interpretation and balanced first bundle.
CODEX_CREATIVE_MODEL=gpt-5.6-terra
CODEX_CREATIVE_REASONING_EFFORT=medium
# Every first candidate uses Terra; high quality may use Sol once after evidence-driven review.
# CODEX_AUTHORING_MODEL remains an optional explicit override for every quality.
CODEX_AUTHORING_MODEL=
CODEX_BALANCED_AUTHORING_MODEL=gpt-5.6-terra
CODEX_HIGH_QUALITY_AUTHORING_MODEL=gpt-5.6-terra
CODEX_AUTHORING_REASONING_EFFORT=medium
# Sol is reserved for one evidence-driven refinement of an already runnable page.
CODEX_VISUAL_REFINEMENT_MODEL=gpt-5.6-sol
CODEX_VISUAL_REFINEMENT_REASONING_EFFORT=medium
DEDICATED_CODE_TIMEOUT_MS=90000
CODEX_VISUAL_ACCEPTANCE_MODEL=gpt-5.6-luna
CODEX_VISUAL_ACCEPTANCE_REASONING_EFFORT=low
VISUAL_ACCEPTANCE_TIMEOUT_MS=30000
VISUAL_REFINEMENT_TIMEOUT_MS=45000

# MiniMax OpenAI-compatible API
# Xiaomi MiMo OpenAI-compatible API (text/page blueprint generation)
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_TIMEOUT_MS=120000
SIGNAL_ASSET_CACHE_DIR=

# Optional direct OpenAI API provider
OPENAI_API_KEY=
OPENAI_CREATIVE_MODEL=gpt-5.6-luna
