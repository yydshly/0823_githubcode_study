{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kindergrimm-research/0.2",
  "title": "Kindergrimm Batch Manifest",
  "type": "object",
  "required": ["schemaVersion", "generator", "batch", "spritesheet", "assets"],
  "properties": {
    "schemaVersion": { "const": "kindergrimm-research/0.2" },
    "generator": {
      "type": "object",
      "required": ["name", "source", "upstreamCommit", "license", "representation", "runtime", "runtimeLlmCalls", "cloudApiCalls"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "upstreamCommit": { "type": "string" },
        "license": { "type": "string" },
        "representation": { "type": "string" },
        "runtime": { "type": "string" },
        "runtimeLlmCalls": { "type": "integer", "minimum": 0 },
        "cloudApiCalls": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "batch": {
      "type": "object",
      "required": ["id", "input", "count", "unique", "deterministicOrder"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "input": { "type": "object" },
        "count": { "type": "integer", "minimum": 1, "maximum": 24 },
        "unique": { "type": "integer", "minimum": 1, "maximum": 24 },
        "deterministicOrder": { "const": true }
      },
      "additionalProperties": false
    },
    "spritesheet": {
      "type": "object",
      "required": ["tileSize", "columns", "rows", "width", "height", "background", "order"],
      "properties": {
        "tileSize": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "const": "transparent" },
        "order": { "const": "row-major" }
      },
      "additionalProperties": false
    },
    "contentPack": { "$ref": "./content-pack.schema.json" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "fingerprint", "batchIndex", "representation", "recipe"],
        "properties": {
          "id": { "type": "string", "pattern": "^npc-[0-9a-f]{8}$" },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
          "batchIndex": { "type": "integer", "minimum": 0 },
          "representation": { "const": "procedural-2d-canvas-texture" },
          "recipe": { "$ref": "./recipe.schema.json" },
          "visual": { "$ref": "./visual-record.schema.json" }
        },
        "additionalProperties": false
      }
    },
    "bundle": { "type": "object" }
  },
  "additionalProperties": false
}
