{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kindergrimm-content-pack/0.1",
  "title": "Kindergrimm Content Pack",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "status", "provenance", "constraints", "identity", "presentation", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": "kindergrimm-content-pack/0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["upstream-content", "research-prototype", "authored-content"] },
    "provenance": {
      "type": "object",
      "required": ["kind", "source", "upstreamCommit", "license"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "upstreamCommit": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": ["mode", "species", "media"],
      "properties": {
        "mode": { "enum": ["input-driven", "locked"] },
        "species": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "media": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "color": { "enum": ["auto", "plain", "color"] },
        "colors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["auto", "plain", "color"] } }
      },
      "additionalProperties": false
    },
    "visual": { "$ref": "./renderer.schema.json" },
    "identity": {
      "type": "object",
      "required": ["names", "roles"],
      "properties": {
        "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "roles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["name", "shortName", "label", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
  },
  "additionalProperties": false
}
